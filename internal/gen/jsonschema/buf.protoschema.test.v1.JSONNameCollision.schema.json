{
  "$id": "buf.protoschema.test.v1.JSONNameCollision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "allOf": [
    {
      "oneOf": [
        {
          "required": [
            "baz_qux"
          ]
        },
        {
          "required": [
            "baz"
          ]
        },
        {
          "required": [
            "qux"
          ]
        },
        {
          "propertyNames": {
            "not": {
              "enum": [
                "baz_qux",
                "baz",
                "qux"
              ]
            }
          }
        }
      ]
    }
  ],
  "patternProperties": {
    "^(baz)$": {
      "type": "string"
    },
    "^(foo)$": {
      "default": "",
      "type": "string"
    }
  },
  "properties": {
    "bar": {
      "anyOf": [
        {
          "maximum": 2147483647,
          "minimum": -2147483648,
          "type": "integer"
        },
        {
          "pattern": "^-?[0-9]+$",
          "type": "string"
        }
      ],
      "default": 0
    },
    "baz_qux": {
      "type": "string"
    },
    "foo_bar": {
      "default": "",
      "type": "string"
    },
    "qux": {
      "type": "string"
    }
  },
  "title": "JSON Name Collision",
  "type": "object"
}
