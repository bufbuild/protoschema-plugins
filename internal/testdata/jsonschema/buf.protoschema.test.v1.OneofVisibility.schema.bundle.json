{
  "$defs": {
    "buf.protoschema.test.v1.OneofVisibility.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "visible_choice"
              ]
            },
            {
              "required": [
                "visibleChoice"
              ]
            },
            {
              "required": [
                "hidden_choice"
              ]
            },
            {
              "required": [
                "hiddenChoice"
              ]
            },
            {
              "propertyNames": {
                "not": {
                  "enum": [
                    "visible_choice",
                    "visibleChoice",
                    "hidden_choice",
                    "hiddenChoice"
                  ]
                }
              }
            }
          ]
        }
      ],
      "patternProperties": {
        "^(hidden_choice|hiddenChoice)$": {
          "type": "string"
        },
        "^(visibleChoice)$": {
          "type": "string"
        }
      },
      "properties": {
        "visible_choice": {
          "type": "string"
        }
      },
      "title": "Oneof Visibility",
      "type": "object"
    }
  },
  "$id": "buf.protoschema.test.v1.OneofVisibility.schema.bundle.json",
  "$ref": "#/$defs/buf.protoschema.test.v1.OneofVisibility.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
