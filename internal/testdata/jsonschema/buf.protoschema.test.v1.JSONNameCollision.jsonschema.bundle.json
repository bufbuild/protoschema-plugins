{
  "$defs": {
    "buf.protoschema.test.v1.JSONNameCollision.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "baz"
              ]
            },
            {
              "required": [
                "baz_qux"
              ]
            },
            {
              "required": [
                "qux"
              ]
            },
            {
              "propertyNames": {
                "not": {
                  "enum": [
                    "baz",
                    "baz_qux",
                    "qux"
                  ]
                }
              }
            }
          ]
        }
      ],
      "patternProperties": {
        "^(baz_qux)$": {
          "type": "string"
        },
        "^(foo_bar)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "bar": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "baz": {
          "type": "string"
        },
        "foo": {
          "default": "",
          "type": "string"
        },
        "qux": {
          "type": "string"
        }
      },
      "title": "JSON Name Collision",
      "type": "object"
    }
  },
  "$id": "buf.protoschema.test.v1.JSONNameCollision.jsonschema.bundle.json",
  "$ref": "#/$defs/buf.protoschema.test.v1.JSONNameCollision.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
